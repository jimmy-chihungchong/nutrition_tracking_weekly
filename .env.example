# Copy this file to ".env" and fill in your key. Without a key the app runs in demo mode.

# auto = use the LLM if a key is set (fall back to the offline demo table if the API fails)
# llm  = always use the LLM          demo = always use the offline demo table
NUTRITION_PROVIDER=auto

# Any OpenAI-compatible chat-completions endpoint works. Default: NVIDIA NIM (https://build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional: a different model for the "Improve My Diet" insights (defaults to LLM_MODEL)
# INSIGHTS_MODEL=meta/llama-3.3-70b-instruct
# LLM_TIMEOUT_SECONDS=90

# Optional: move the data files
# TARGETS_FILE=data/weekly_targets.csv
# MEALS_FILE=data/nutrition_log.xlsx
