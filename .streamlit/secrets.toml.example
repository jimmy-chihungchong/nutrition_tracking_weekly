# Copy these into Streamlit Community Cloud: your app → Settings → Secrets.
# (For a local test of the Google Sheets mode, save a copy as .streamlit/secrets.toml — it is git-ignored.)
# NEVER commit real keys to GitHub.

# --- Your timezone, so "today" is right (the cloud server runs on UTC) ---
APP_TIMEZONE = "Asia/Kolkata"

# --- AI nutrition engine (optional; without it the app runs in demo mode) ---
LLM_API_KEY = "nvapi-your-key-here"
# LLM_BASE_URL = "https://integrate.api.nvidia.com/v1"
# LLM_MODEL = "meta/llama-3.3-70b-instruct"

# --- Google Sheet that stores meals and goals ---
[google_sheets]
spreadsheet_url = "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"

# --- Service account key: paste the fields from the JSON key file you downloaded ---
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nutrition-tracker@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
